# Porta do servidor
PORT=3001

# Conexão com o banco de dados PostgreSQL
DIRECT_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require
DATABASE_URL_POOLED=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require

# Variáveis individuais do PostgreSQL (opcional/alternativo)
PGHOST=localhost
PGPORT=5432
PGUSER=usuario
PGPASSWORD=senha
PGDATABASE=nome_banco
